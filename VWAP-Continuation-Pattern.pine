    table.cell(debugTable, 1, 1, str.tostring(daily_atr, "###.##"), bgcolor = color.new(color.teal,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 0, 2,"Entry Level", bgcolor = color.new(color.teal,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 1, 2, str.tostring(entryLevel, "###.##"), bgcolor = color.new(color.teal,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 0, 3,"VWAP Value", bgcolor = color.new(color.lime,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 1, 3, str.tostring(vwapVal, "###.##"), bgcolor = color.new(color.lime,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 0, 4,"Sup Break Checks 1-2", bgcolor = color.new(color.blue,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 1, 4, str.tostring(supBreakCheck1), bgcolor = color.new(color.blue,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 2, 4, str.tostring(supBreakCheck2), bgcolor = color.new(color.blue,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 0, 5,"Broke Level Confirmed", bgcolor = color.new(color.blue,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 1, 5, str.tostring(broke0930), bgcolor = color.new(color.blue,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 2, 5,"Break Bar", bgcolor = color.new(color.blue,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 3, 5, str.tostring(breakBar, "###.##"), bgcolor = color.new(color.blue,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 0, 6,"Retest Checks 1-5", bgcolor = color.new(color.red,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 1, 6, str.tostring(retestCheck1), bgcolor = color.new(color.red,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
    table.cell(debugTable, 2, 6, str.tostring(retestCheck2), bgcolor = color.new(color.red,75), text_color=color.black, text_size=size.small, text_formatting = text.format_bold)
