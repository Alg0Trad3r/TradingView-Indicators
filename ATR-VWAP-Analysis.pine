//@version=6
indicator("Custom ATR-VWAP-EMA Analysis", shorttitle="ATR-VWAP", overlay=true)

// User inputs
atrLength = input.int(14, title="ATR Length", minval=1, display = display.none)
emaLength = input.int(9, title="EMA Length", minval=1, display = display.none)
ema2Length = input.int(21, title="EMA 2 Length", minval=1, display = display.none)

// Calculating the ATR based off 
daily_atr = math.round(request.security(syminfo.tickerid, "1D", ta.atr(atrLength)[1], lookahead = barmerge.lookahead_on), 2)
atrPercentOfPrice = (daily_atr / close) * 100


// Display: Plot ATR
var table atrTable = table.new(position.bottom_left, columns=6, rows=15, bgcolor=color.black, border_color=color.white)

//Plotting ATR
table.cell(atrTable, 0, 0, "ATR", text_color = color.white )
table.cell(atrTable, 1, 0, str.tostring(daily_atr, "##.##"), text_color = color.white)

//Plotting ATR % of Price
table.cell(atrTable, 0, 1, "ATR % of Price:", text_color=color.white)
table.cell(atrTable, 1, 1, str.tostring(atrPercentOfPrice, "#.##") + "%", text_color=color.white)

// Calculating the distance price has moved away from VWAP 
vwap = ta.vwap(hlc3)

// Detect recent swings (lookback 45 bars left/right)
pivotLow = ta.pivotlow(low, 45, 0)
pivotHigh = ta.pivothigh(high, 45, 0)

// Track latest pivot prices and VWAP at pivot
var float lastPivotLow = na
var float vwapAtLow = na
var float lastPivotHigh = na
var float vwapAtHigh = na

if not na(pivotLow)
    lastPivotLow := pivotLow
    vwapAtLow := vwap
if not na(pivotHigh)
    lastPivotHigh := pivotHigh
    vwapAtHigh := vwap

// Calculate the distance between the Pivots and VWAP to compare to the ATR
float distancePercentOfAtr = na
if close < math.abs(vwap)
    priceDistanceFromVwap = math.abs(lastPivotLow - vwap)
    distancePercentOfAtr := (priceDistanceFromVwap / daily_atr) * 100
else if close > math.abs(vwap)
    priceDistanceFromVwap = math.abs(lastPivotHigh - vwap)
    distancePercentOfAtr := (priceDistanceFromVwap / daily_atr) * 100

// Display: Plot VWAP and show percentage in table
plot(vwap, color=color.blue, title="VWAP", display = display.none)
table.cell(atrTable, 0, 2, "Price Dist From VWAP % of ATR:", text_color=color.white) 
table.cell(atrTable, 1, 2, str.tostring(distancePercentOfAtr, "#.##") + "%", text_color=color.white)

// Creating And Plotting 9 EMA and 21 EMA
ema9 = ta.ema(close, emaLength)
plot(ema9, color=color.red, title="EMA9", display = display.none)
ema21 = ta.ema(close, ema2Length)
plot(ema21, color = color.green, title = "EMA21", display = display.none)

if not na(pivotLow)
    lastPivotLow := pivotLow
    vwapAtLow := vwap
if not na(pivotHigh)
    lastPivotHigh := pivotHigh
    vwapAtHigh := vwap

// Detect crosses
bullishCross = ta.crossover(ema9, vwap)
bearishCross = ta.crossunder(ema9, vwap)

// At cross, calculate measured move and percentage
float measuredMove = na
float crossDistancePercent = na
if bullishCross and not na(lastPivotLow)
    measuredMove := math.abs(lastPivotLow - vwapAtLow)  // Size from low to VWAP at pivot
    crossDistancePercent := (math.abs(close - vwap) / measuredMove) * 100
if bearishCross and not na(lastPivotHigh)
    measuredMove := math.abs(lastPivotHigh - vwapAtHigh)  // Size from high to VWAP at pivot
    crossDistancePercent := (math.abs(close - vwap) / measuredMove) * 100

// Display: Label on cross
if bullishCross or bearishCross
    table.cell(atrTable, 0, 3, text = "Cross Dist % of Measured Move: ", text_color = color.white)
    table.cell(atrTable, 1, 3, text = str.tostring(crossDistancePercent, "#.##") + "%", text_color = color.white)

// Calculating the distance between VWAP and 9 EMA
float emaVwapDistance = math.abs(ema9 - vwap)
if close > math.abs(vwap)
    emaVwapDistance := math.abs(ema9 + vwap)
else if close < math.abs(vwap)
    emaVwapDistance := math.abs(ema9 - vwap)

// State tracking
var int divergenceBars = 0
var int convergenceBars = 0
var bool inDivergence = false
var bool inConvergence = false

// Detect phase changes
if emaVwapDistance > emaVwapDistance[1] and not inDivergence
    inDivergence := true
    inConvergence := false
    divergenceBars := 1  // Start count of bars
else if emaVwapDistance > emaVwapDistance[1] and inDivergence
    divergenceBars += 1
else if emaVwapDistance < emaVwapDistance[1] and not inConvergence
    inConvergence := true
    inDivergence := false
    convergenceBars := 1
else if emaVwapDistance < emaVwapDistance[1] and inConvergence
    convergenceBars += 1
else
    // Reset if flat
    inDivergence := false
    inConvergence := false
    divergenceBars := 0
    convergenceBars := 0

// At cross, calculate percentage if prior divergence/convergence
float timePercent = na
if (bullishCross or bearishCross) and divergenceBars > 0 and convergenceBars > 0
    timePercent := (convergenceBars / divergenceBars) * 100
    // Reset after cross
    divergenceBars := 0
    convergenceBars := 0

// Display: Label on cross
if (bullishCross or bearishCross) and not na(timePercent)
    //label.new(bar_index, low, "Conv Time % of Div: " + str.tostring(timePercent, "#.##") + "%", yloc=yloc.belowbar, color=color.orange, style=label.style_label_up)
    table.cell(atrTable, 0, 4, text = "Conv Time % of Div: ", text_color = color.white)
    table.cell(atrTable, 1, 4, text = str.tostring(timePercent, "#.##") + "%", text_color = color.white)
