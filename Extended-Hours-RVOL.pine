//@version=6
indicator("Extended Hours RVOL", overlay=true, max_bars_back=5000)

// |============================================================================
// |                            IMPORTS
// |============================================================================

import forrestobnamia/OGV_Library/43 as OGV

//Inputs
avgLookbackExtended = input.int(22,  "Lookback for Extended Hours Average Volume", display = display.none)
avgLookbackReg = input.int(22,  "Lookback for Regular Market Average Volume", display = display.none)
showTable = input.bool(true, "Show RVOL Table")
statTablePosition = input.enum(OGV.table_position.bottomRight, "State Table Position", display=display.none)

// ──────────────────────────────────────
// TIME WINDOWS (NY/EST)
// ──────────────────────────────────────
int currentTime = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")

int PreMktStart  = 4 * 60        // 04:00
int PreMktEnd    = 9 * 60 + 29   // 09:29
int PostMktStart = 16 * 60       // 16:00
int PostMktEnd   = 20 * 60       // 20:00

bool inPreMkt  = currentTime >= PreMktStart and currentTime <= PreMktEnd
bool inPostMkt = currentTime >= PostMktStart and currentTime < PostMktEnd
bool inRegMkt = currentTime > PreMktEnd and currentTime < PostMktStart

// Detect new trading day (at 04:00 AM EST)
bool newTradingDay = ta.change(time("D")) != 0 and inPreMkt

// ──────────────────────────────────────
// VOLUME ACCUMULATION
// ──────────────────────────────────────
var float todayPreVolume   = 0.0     // Current day's pre-market volume
var float todayPostVolume  = 0.0     // Current day's post-market volume
var float yesterdayPostVol = 0.0     // Saved from previous day
var float regMktVolume = 0.0         // Regular Market volume calculation variable

// Accumulate volume in real time of After Hours, Pre Market and Regular Hours
if inPreMkt
    todayPreVolume += volume * 10

if inPostMkt
    todayPostVolume += volume * 10

if inRegMkt
    regMktVolume += volume * 10

// Reset at start of new trading day
if newTradingDay
    // Save yesterday's post-market volume before resetting
    yesterdayPostVol := todayPostVolume
    
    // Reset current day counters
    todayPreVolume  := 0.0
    todayPostVolume := 0.0
    regMktVolume := 0.0

// ──────────────────────────────────────
// CALCULATE CURRENT EXTENDED VOLUME & STORE DAILY
// ──────────────────────────────────────
float currentExtendedVol = yesterdayPostVol + todayPreVolume

var float[] dailyExtendedVol = array.new_float()  // Stores last User defined days' (Prev Post + Today Pre)
var float[] dailyRegularVol = array.new_float()  // Stores last User defined days' (Regular Market Hours)

// When pre-market ends → we have a complete "daily extended volume" to store
bool preMarketJustEnded = currentTime == PreMktEnd + 1
// When post-market starts we complete 1 regular hours trading day to store
bool postMktStarted = currentTime == PostMktStart 

if preMarketJustEnded
    array.push(dailyExtendedVol, currentExtendedVol)
    // Keep only last days set by the user
    if array.size(dailyExtendedVol) >= avgLookbackExtended
        array.shift(dailyExtendedVol)

if postMktStarted
    array.push(dailyRegularVol, regMktVolume)
    // Keep only last days set by the user
    if array.size(dailyRegularVol) >= avgLookbackReg
        array.shift(dailyRegularVol)
    regMktVolume := 0.0

// Calculations of RVOL and AVG Volume based on user set length lookback period
float avgExtendedVol = array.size(dailyExtendedVol) > 0 ? array.avg(dailyExtendedVol) : na
float rvol = avgExtendedVol > 0 ? currentExtendedVol / avgExtendedVol : na // Calculates RVOL of Extended Hours based off of AVG Extended Hours Volume
float avgRegVol = array.size(dailyRegularVol) > 0 ? array.avg(dailyRegularVol) : na
float htfRVOL = currentExtendedVol / avgRegVol // Calculates Extended Hours RVOL based off of Regular Hours Average volume

// ──────────────────────────────────────
// DISPLAY TABLE
// ──────────────────────────────────────
// TABLE POSITION
statTablePos = statTablePosition == OGV.table_position.topLeft ? position.top_left : 
         statTablePosition == OGV.table_position.topRight ? position.top_right : 
         statTablePosition == OGV.table_position.bottomLeft ? position.bottom_left :
         position.bottom_right
if showTable
    var table rvolTable = table.new(statTablePos, 2, 10, bgcolor=color.new(color.black, 85), 
                                    border_width=2, frame_color=color.yellow, frame_width=2)

    table.cell(rvolTable, 0, 0, "Extended Hours RVOL Chart", bgcolor=color.navy, text_color=color.white, 
                text_size=size.large, text_formatting=text.format_bold)
    table.cell(rvolTable, 0, 1, "Extended Hours Volume", bgcolor=color.new(color.navy, 70), text_color=color.white, text_size=size.normal)
    table.cell(rvolTable, 1, 1, str.tostring(math.round(currentExtendedVol), "#,###"), 
                text_color=color.yellow, text_size=size.normal, text_formatting=text.format_bold)
    table.cell(rvolTable, 0, 2, "Extened Hours Average Volume", bgcolor=color.new(color.navy, 70), text_color=color.white, text_size=size.normal)
    table.cell(rvolTable, 1, 2, avgExtendedVol > 0 ? str.tostring(math.round(avgExtendedVol), "#,###") : "N/A", 
                text_color=color.rgb(0, 225, 255), text_size=size.normal)
    table.cell(rvolTable, 0, 3, "Regular Hours Average Volume", bgcolor=color.new(color.navy, 70), text_color=color.white, text_size=size.normal)
    table.cell(rvolTable, 1, 3, avgRegVol > 0 ? str.tostring(math.round(avgRegVol), "#,###") : "N/A", 
                text_color=color.rgb(0, 119, 255), text_size=size.normal)
    table.cell(rvolTable, 0, 4, "Extended Hours RVOL (AVG Extended)", bgcolor=color.new(color.purple, 80), text_color=color.white, text_size=size.large, text_formatting=text.format_bold)
    table.cell(rvolTable, 1, 4, rvol > 0 ? str.tostring(rvol, "0.00") + "x" : "N/A", 
                text_color=rvol >= 1.5 ? color.red : rvol >= 0.7 ? color.green : rvol <= 0.6 ? color.yellow : color.green,
                text_size=size.large, text_formatting=text.format_bold)
    table.cell(rvolTable, 0, 5, "Extended Hours RVOL (AVG Regular)", bgcolor=color.new(color.purple, 80), text_color=color.white, text_size=size.large, text_formatting=text.format_bold)
    table.cell(rvolTable, 1, 5, htfRVOL > 0 ? str.tostring(htfRVOL, "0.00") + "x" : "N/A", 
                text_color=htfRVOL >= 0.1 ? color.red : htfRVOL >= 0.06 ? color.green : htfRVOL <= 0.05 ? color.yellow : color.green,
                text_size=size.large, text_formatting=text.format_bold)
    table.cell(rvolTable, 0, 6, "Pre-Market Volume", bgcolor=color.new(color.blue, 80), text_color=color.white, text_size=size.normal)
    table.cell(rvolTable, 1, 6, str.tostring(math.round(todayPreVolume), "#,###"), text_color=color.blue, text_size=size.normal)
    table.cell(rvolTable, 0, 7, "Prev Post-Market Volume", bgcolor=color.new(color.purple, 80), text_color=color.white, text_size=size.normal)
    table.cell(rvolTable, 1, 7, str.tostring(math.round(yesterdayPostVol), "#,###"), text_color=color.fuchsia, text_size=size.normal)
    table.cell(rvolTable, 0, 8, "Regular Market Volume", bgcolor=color.new(color.purple, 80), text_color=color.white, text_size=size.normal)
    table.cell(rvolTable, 1, 8, str.tostring(math.round(regMktVolume), "#,###"), text_color=color.rgb(251, 154, 64), text_size=size.normal)
    table.cell(rvolTable, 0, 9, "Average Calculation Lookback", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(rvolTable, 1, 9, str.tostring(array.size(dailyExtendedVol) + 1), text_color=color.gray, text_size=size.small)

